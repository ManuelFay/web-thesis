---
import "katex/dist/katex.min.css";
import "../styles/global.css";
import site from "../generated/site.json";
import ThesisSearch from "../components/ThesisSearch.astro";

const {
  title,
  description = "Document Retrieval Beyond Text Embeddings — the doctoral thesis of Manuel Faysse.",
  activeSlug = ""
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f1e8" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="Thesis home">
        <span>MF</span>
        <span>Document Retrieval<br />Beyond Text Embeddings</span>
      </a>
      <nav aria-label="Site links">
        <ThesisSearch />
        <a class="header-about-link" href="https://manuelfay.github.io/">About Manuel</a>
        <a class="header-read-link" href={`${base}chapters/introduction/`}>Read</a>
        <a class="header-pdf-link" href={`${base}Thesis.pdf`}><span aria-hidden="true">↓</span> PDF</a>
        <button class="theme-toggle" type="button" aria-label="Toggle colour theme">◐</button>
      </nav>
    </header>
    <div class="site-shell">
      <aside class="book-nav" aria-label="Thesis chapters">
        <p class="eyebrow">Contents</p>
        {site.outline.map((section) => (
          <section>
            <h2>{section.label}</h2>
            <ol>
              {section.chapters.map((chapter) => (
                <li class:list={{ active: activeSlug === chapter.slug }}>
                  <span>{chapter.number || "·"}</span>
                  <a href={`${base}chapters/${chapter.slug}/`}>{chapter.navTitle}</a>
                </li>
              ))}
            </ol>
          </section>
        ))}
        <p class="prototype-note">Complete web edition · Generated directly from the LaTeX thesis sources.</p>
      </aside>
      <main id="content"><slot /></main>
    </div>
    <footer class="site-footer">
      <p>Manuel Faysse · Université Paris-Saclay</p>
      <p>Generated from the LaTeX thesis sources.</p>
    </footer>
    <script is:inline>
      const key = "thesis-theme";
      const root = document.documentElement;
      const saved = localStorage.getItem(key);
      if (saved) root.dataset.theme = saved;
      document.querySelector(".theme-toggle")?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem(key, next);
      });
      const revealSearchDestination = async () => {
        const highlight = new URLSearchParams(location.search).get("highlight");
        if (highlight) {
          const siteBase = document.querySelector("[data-search-root]")?.dataset.base || "/";
          try {
            const { default: PagefindHighlight } = await import(`${siteBase}pagefind/pagefind-highlight.js`);
            new PagefindHighlight({ highlightParam: "highlight", addStyles: false });
          } catch (error) {
            console.warn("Search highlighting could not be loaded.", error);
          }
        }
        const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
        setTimeout(() => {
          const highlights = [...document.querySelectorAll("mark.pagefind-highlight")];
          const sectionMatch = target
            ? highlights.find((mark) => target.contains(mark) || Boolean(target.compareDocumentPosition(mark) & Node.DOCUMENT_POSITION_FOLLOWING))
            : highlights[0];
          (sectionMatch || target)?.scrollIntoView({ block: sectionMatch ? "center" : "start" });
        }, 120);
      };
      if (document.readyState === "complete") revealSearchDestination();
      else addEventListener("load", revealSearchDestination, { once: true });
    </script>
  </body>
</html>
